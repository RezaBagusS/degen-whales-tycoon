datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String       @id @default(uuid())
  username      String       @unique
  email         String?
  passwordHash  String?
  walletAddress String?      @unique
  isBanned      Boolean      @default(false)
  banReason     String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  save          GameSave?
  syndicateId   String?
  syndicate     Syndicate?   @relation(fields: [syndicateId], references: [id])

  @@index([username])
  @@index([email])
}

model BroadcastAnnouncement {
  id        String   @id @default(uuid())
  message   String
  type      String   @default("info")
  isActive  Boolean  @default(true)
  expiresAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GameSave {
  id                   String   @id @default(uuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  cash                 Float    @default(10.0)
  peakNetWorth         Float    @default(10.0)
  whaleTokens          Int      @default(0)
  currentLocationLevel Int      @default(1)
  
  // JSON payload stores upgrades, inventory, activeEffects, trade history
  upgrades             Json     @default("{}")
  inventory            Json     @default("{\"pump_whistle\":0,\"dump_horn\":0,\"liq_shield\":0,\"leverage_250x\":0,\"zero_fee\":0,\"insider_radar\":0}")
  activeEffects        Json     @default("{\"zeroFeeUntil\":0,\"has250xTicket\":false,\"radarUntil\":0}")
  activePosition       Json?
  tradeHistory         Json     @default("[]")
  savePayload          Json?

  // Season / Prestige System
  seasonTrophies       Json     @default("[]")  // Permanent trophy hall — never reset
  currentSeasonId      String?

  lastSavedAt          DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model Syndicate {
  id               String   @id @default(uuid())
  name             String   @unique
  tag              String   @unique
  description      String?
  treasury         Float    @default(0.0)
  totalWhaleTokens Int      @default(0)
  
  members          User[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// ─── Season / Prestige Reset System ─────────────────────────────────────────

model Season {
  id          String   @id @default(uuid())
  number      Int      @unique                // Season 1, 2, 3 ...
  startDate   DateTime
  endDate     DateTime                        // Auto-reset runs when endDate is reached
  isActive    Boolean  @default(true)
  resetAt     DateTime?                       // Timestamp when the reset was executed
  prizePool   Json     @default("{}")         // { first: 100, second: 50, third: 25 }

  leaderboard SeasonLeaderboard[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
  @@index([endDate])
}

model SeasonLeaderboard {
  id           String   @id @default(uuid())
  seasonId     String
  season       Season   @relation(fields: [seasonId], references: [id])
  userId       String
  username     String
  rank         Int
  peakNetWorth Float
  trophy       String   // e.g. "🐋 Grand Whale Trophy S1"
  seasonTitle  String   // e.g. "Whale Supremacy S1"
  headStart    Float    @default(0)           // Bonus cash added at next season start
  snapshotAt   DateTime @default(now())

  @@unique([seasonId, userId])
  @@index([seasonId, rank])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId, code])
}
