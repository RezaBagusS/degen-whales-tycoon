# 1. DATABASE CONFIGURATION (PostgreSQL / Neon)
# Production connection URL with SSL enabled:
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-YOUR-PROJECT-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# 2. APPLICATION URL
# The canonical domain URL where your application is hosted:
NEXT_PUBLIC_APP_URL="https://degen-whales-tycoon.vercel.app"

# 3. ADMIN DASHBOARD OPERATIONS SECRET KEY
# Used to authenticate to the /admin Ops & Monitoring portal and secure admin APIs:
# In development, default key is 'dw_admin_9x7f2026_whale' (hidden in production builds)
ADMIN_SECRET_KEY="dw_admin_9x7f2026_whale"

# 4. SESSION SECURITY KEY
# Salt/secret used for session token HMAC hashing:
SESSION_SECRET="degen_whale_syndicate_secret_salt_2026"

# 5. SMTP EMAIL CONFIGURATION (Forgot Password OTP Delivery)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="rezabagussaputrait@gmail.com"
SMTP_PASS="your_16_char_gmail_app_password"

# 6. SENTRY TELEMETRY (Optional)
# SENTRY_DSN=""
# NEXT_PUBLIC_SENTRY_DSN=""
